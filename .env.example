# Security
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=replace-with-a-unique-password

# Cloudflare
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here
DOMAIN=yourdomain.com

# Server
WEB_PORT=8000
WEB_HOST=127.0.0.1
UDP_PORT=6980
SESSION_TIMEOUT_MINUTES=30
LINK_EXPIRY_MINUTES=10
MAX_UPLOAD_SIZE_MB=50

# Audio (optional: auto-discovered if installed via winget/scoop/choco/path)
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffprobe.exe
FFPLAY_PATH=ffplay
# Optional comma-separated HTTP(S) proxies, tried in order when one fails.
# Use trusted providers; each proxy can see the traffic it forwards.
# DOWNLOADER_PROXIES=http://proxy-one.example:8080,http://proxy-two.example:8080
# Legacy single-proxy setting remains supported: DOWNLOADER_PROXY=http://proxy.example:8080
